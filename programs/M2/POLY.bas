10 REM RANDOM CIRCLE POLYGONS - MODEL II BASICG 640X240
20 SCREEN 0 : CLS
25 DIM X(20), Y(20)
30 PI = 3.141593
40 REM PIXELS ARE 2X TALL AS WIDE SO RX=220, RY=110 GIVES A ROUND CIRCLE
50 FOR NP = 2 TO 20
60 LINE (0,0)-(639,239), 0, BF
70 CIRCLE (320,120), 220, , , , .5
80 A0 = ((2 * PI) * (RND(1000) / 1000))
90 FOR I = 1 TO NP
100 A = (A0 + (((2 * PI) * (I - 1)) / NP))
110 X(I) = INT(320 + (220 * COS(A))) : Y(I) = INT(120 + (110 * SIN(A)))
120 NEXT I
130 FOR I = 1 TO (NP - 1)
140 FOR J = (I + 1) TO NP
150 LINE (X(I),Y(I))-(X(J),Y(J))
160 NEXT J : NEXT I
170 FOR D = 1 TO 3000 : NEXT D
180 NEXT NP
190 GOTO 50
