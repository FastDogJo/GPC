10 REM LEFT/BOTTOM EDGE STRING ART MIRRORED TO RIGHT/TOP - MODEL II BASICG 640X240
20 SCREEN 0 : CLS
30 FOR NP = 2 TO 12
40 LINE (0,0)-(639,239), 0, BF
50 LINE (0,0)-(0,239) : LINE (0,239)-(639,239)
55 LINE (639,0)-(639,239) : LINE (0,0)-(639,0)
60 REM POINT I ON LEFT EDGE IS (0,Y), POINT J ON BOTTOM EDGE IS (X,239)
70 FOR I = 0 TO (NP - 1)
80 Y = INT((239 * I) / (NP - 1))
90 FOR J = 0 TO (NP - 1)
100 X = INT((639 * J) / (NP - 1))
105 IF ((I = 0) AND (J = (NP - 1))) THEN 120
110 LINE (0,Y)-(X,239)
115 LINE (639,(239 - Y))-((639 - X),0)
120 NEXT J : NEXT I
130 FOR D = 1 TO 3000 : NEXT D
140 NEXT NP
