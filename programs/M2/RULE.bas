10 REM ELEMENTARY CELLULAR AUTOMATA (RULE N) - MODEL II BASICG 640X240
20 SCREEN 0 : CLS : DEFINT A-Z
30 REM 320 CELLS, 2 PIXELS WIDE X 1 ROW TALL = SQUARE CELLS, ONE GENERATION PER ROW
40 DIM A(321), RT(7), RU(7)
50 FOR I = 0 TO 7 : READ RU(I) : NEXT I
60 DATA 90,30,110,150,45,18,73,126
70 FOR K = 0 TO 7
80 RL = RU(K)
90 FOR P = 0 TO 7 : RT(P) = (INT(RL / (2 ^ P)) AND 1) : NEXT P
100 LINE (0,0)-(639,239), 0, BF
110 FOR I = 0 TO 321 : A(I) = 0 : NEXT I
120 A(160) = 1
130 FOR Y = 0 TO 239
140 L = 0
150 FOR I = 1 TO 320
160 C = A(I)
170 IF (C = 1) THEN LINE (((2 * I) - 2),Y)-(((2 * I) - 1),Y)
180 A(I) = RT(((L * 4) + (C * 2)) + A(I + 1)) : L = C
190 NEXT I : NEXT Y
200 FOR D = 1 TO 3000 : NEXT D
210 NEXT K
220 GOTO 70
