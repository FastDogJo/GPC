10 REM ARCHIMEDEAN THEN LOGARITHMIC SPIRALS, 1-6 ARMS - MODEL II BASICG 640X240
20 SCREEN 0 : CLS
30 PI = 3.141593 : TM = (10 * PI)
40 FOR M = 0 TO 1
50 FOR NA = 1 TO 6
60 LINE (0,0)-(639,239), 0, BF
70 FOR J = 0 TO (NA - 1)
80 A0 = (((2 * PI) * J) / NA)
90 FOR S = 0 TO 800
100 T = ((TM * S) / 800)
110 IF (M = 0) THEN R = (T / TM) ELSE R = EXP(.25 * (T - TM))
120 X = INT(320 + ((315 * R) * COS(T + A0))) : Y = INT(120 + ((115 * R) * SIN(T + A0)))
130 IF (S = 0) THEN PSET (X,Y) ELSE LINE (OX,OY)-(X,Y)
140 OX = X : OY = Y
150 NEXT S : NEXT J
160 FOR D = 1 TO 3000 : NEXT D
170 NEXT NA : NEXT M
180 GOTO 40
