10 REM STARBURST - CENTER RAYS PLUS STAR POLYGON - MODEL II BASICG 640X240
20 SCREEN 0 : CLS
30 PI = 3.141593
40 DIM X(128), Y(128)
50 FOR L = 3 TO 7
60 NP = INT((2 ^ L) + .5) : K = INT(NP * .4)
70 LINE (0,0)-(639,239), 0, BF
80 FOR I = 0 TO (NP - 1)
90 A = (((2 * PI) * I) / NP)
100 X(I) = INT(320 + (315 * COS(A))) : Y(I) = INT(120 + (115 * SIN(A)))
110 NEXT I
120 FOR I = 0 TO (NP - 1)
130 J = (I + K) : IF (J >= NP) THEN J = (J - NP)
140 LINE (320,120)-(X(I),Y(I))
150 LINE (X(I),Y(I))-(X(J),Y(J))
160 NEXT I
170 FOR D = 1 TO 3000 : NEXT D
180 NEXT L
190 GOTO 50
