10 REM KOCH SNOWFLAKE, DRAGON CURVE AND H-TREE - MODEL II BASICG 640X240
20 SCREEN 0 : CLS
30 PI = 3.141593
40 REM PIXELS ARE 2X TALL AS WIDE SO Y IS HELD IN PHYSICAL UNITS AND HALVED WHEN DRAWN (ROW = Y / 2)
50 DIM OA(3), DX(3), DY(3), SX(40), SY(40), SL(40), SD(40)
60 OA(0) = 0 : OA(1) = 1 : OA(2) = -1 : OA(3) = 0
70 DX(0) = 1 : DX(1) = 0 : DX(2) = -1 : DX(3) = 0
80 DY(0) = 0 : DY(1) = 1 : DY(2) = 0 : DY(3) = -1
100 REM KOCH SNOWFLAKE LEVELS 0-4: DIRECTION OF SEGMENT K = SUM OF OFFSETS OF ITS BASE-4 DIGITS (UNITS OF 60 DEGREES)
110 SS = 380 : RR = (SS / SQR(3))
120 FOR LV = 0 TO 4
130 LINE (0,0)-(639,239), 0, BF
140 NS = (4 ^ LV) : ST = (SS / (3 ^ LV))
150 X = 0 : Y = RR
160 FOR SI = 0 TO 2
170 B = (-1 - (2 * SI))
180 FOR K = 0 TO (NS - 1)
190 DR = B : K2 = K
200 FOR J = 1 TO LV : DR = (DR + OA(K2 - (4 * INT(K2 / 4)))) : K2 = INT(K2 / 4) : NEXT J
210 A = ((DR * PI) / 3)
220 NX = (X + (ST * COS(A))) : NY = (Y + (ST * SIN(A)))
230 LINE (INT(320 + X),INT(120 - (Y / 2)))-(INT(320 + NX),INT(120 - (NY / 2)))
240 X = NX : Y = NY
250 NEXT K : NEXT SI
260 FOR D = 1 TO 3000 : NEXT D
270 NEXT LV
300 REM DRAGON CURVE LEVELS 4-12: PASS 0 FINDS THE EXTENTS, PASS 1 DRAWS SCALED TO FIT
310 FOR LV = 4 TO 12
320 NS = (2 ^ LV)
330 FOR PS = 0 TO 1
340 X = 0 : Y = 0 : DR = 0
350 IF (PS = 0) THEN X0 = 0 : X1 = 0 : Y0 = 0 : Y1 = 0
360 IF (PS = 1) THEN LINE (0,0)-(639,239), 0, BF : CX = ((X0 + X1) / 2) : CY = ((Y0 + Y1) / 2) : SC = (600 / (X1 - X0)) : IF ((440 / (Y1 - Y0)) < SC) THEN SC = (440 / (Y1 - Y0))
370 FOR K = 1 TO NS
380 NX = (X + DX(DR)) : NY = (Y + DY(DR))
390 IF (PS = 0) THEN 420
400 LINE (INT(320 + (SC * (X - CX))),INT(120 - ((SC * (Y - CY)) / 2)))-(INT(320 + (SC * (NX - CX))),INT(120 - ((SC * (NY - CY)) / 2)))
410 GOTO 450
420 IF (NX < X0) THEN X0 = NX
430 IF (NX > X1) THEN X1 = NX
440 IF (NY < Y0) THEN Y0 = NY
445 IF (NY > Y1) THEN Y1 = NY
450 X = NX : Y = NY
460 K2 = K
470 IF ((K2 - (2 * INT(K2 / 2))) = 0) THEN K2 = INT(K2 / 2) : GOTO 470
480 IF ((K2 - (4 * INT(K2 / 4))) = 1) THEN DR = (DR + 1) ELSE DR = (DR - 1)
490 IF (DR > 3) THEN DR = 0
500 IF (DR < 0) THEN DR = 3
510 NEXT K
520 NEXT PS
530 FOR D = 1 TO 2000 : NEXT D
540 NEXT LV
600 REM H-TREE LEVELS 1-6 (EXPLICIT STACK INSTEAD OF RECURSION)
610 FOR LV = 1 TO 6
620 LINE (0,0)-(639,239), 0, BF
630 SP = 1 : SX(1) = 320 : SY(1) = 240 : SL(1) = 440 : SD(1) = LV
640 IF (SP = 0) THEN 720
650 X = SX(SP) : Y = SY(SP) : L = SL(SP) : DP = SD(SP) : SP = (SP - 1)
660 H = (L / 2) : XA = INT(X - H) : XB = INT(X + H) : YA = INT((Y - H) / 2) : YB = INT((Y + H) / 2) : YM = INT(Y / 2)
670 LINE (XA,YM)-(XB,YM) : LINE (XA,YA)-(XA,YB) : LINE (XB,YA)-(XB,YB)
680 IF (DP = 1) THEN 640
690 FOR CC = 0 TO 3
700 SP = (SP + 1) : SX(SP) = ((X - H) + ((CC AND 1) * L)) : SY(SP) = ((Y - H) + (((CC AND 2) / 2) * L)) : SL(SP) = H : SD(SP) = (DP - 1)
710 NEXT CC : GOTO 640
720 FOR D = 1 TO 3000 : NEXT D
730 NEXT LV
740 GOTO 120
