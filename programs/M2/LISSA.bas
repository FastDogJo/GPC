10 REM LISSAJOUS FIGURES - MODEL II BASICG 640X240
20 SCREEN 0 : CLS
30 PI = 3.141593
40 DIM A(7), B(7)
50 FOR I = 1 TO 7 : READ A(I), B(I) : NEXT I
60 DATA 1,2,3,2,3,4,5,4,5,6,7,6,3,5
70 FOR K = 1 TO 7
80 LINE (0,0)-(639,239), 0, BF
90 FOR S = 0 TO 720
100 T = (((2 * PI) * S) / 720)
110 X = INT(320 + (315 * COS(A(K) * T))) : Y = INT(120 + (115 * SIN(B(K) * T)))
120 IF (S = 0) THEN PSET (X,Y) ELSE LINE (OX,OY)-(X,Y)
130 OX = X : OY = Y
140 NEXT S
150 FOR D = 1 TO 3000 : NEXT D
160 NEXT K
170 GOTO 70
