10 REM CONWAY'S GAME OF LIFE - Z80 HELPER (LIFE.ASM) - MODEL II BASICG 640X240, 1 PIXEL CELLS, WRAPS AT EDGES
20 DEFINT A-Z : I = 0 : G = 0 : X = 0 : U = 0 : N = 0 : O = 0 : H = 0 : BA! = 0 : W! = 0
30 DIM B(377), C(354)
40 BA! = VARPTR(C(0)) : IF (BA! < 0) THEN BA! = (BA! + 65536!)
50 READ N : FOR I = 0 TO (N - 1) : READ B(I) : NEXT I
60 READ N : FOR I = 1 TO N : READ O : W! = (B(O) + (256! * B(O + 1)) + BA!) : IF (W! > 65535!) THEN W! = (W! - 65536!)
70 H = INT(W! / 256) : B(O) = (W! - (H * 256!)) : B(O + 1) = H : NEXT I
80 FOR I = 0 TO 188 : W! = (B(2 * I) + (256! * B((2 * I) + 1))) : IF (W! > 32767!) THEN W! = (W! - 65536!)
85 C(I) = W! : NEXT I
90 IF (BA! > 32767!) THEN U = (BA! - 65536!) ELSE U = BA!
100 DEFUSR0 = U
110 SCREEN 0 : CLS : LINE (0,0)-(639,239), 0, BF
120 REM C(1) = MODE (0 = RANDOM FILL, 1 = ONE GENERATION), C(2) = RANDOM SEED
130 C(2) = RND(30000)
140 C(1) = 0 : X = USR0(0)
150 C(1) = 1
160 FOR G = 1 TO 150 : X = USR0(0) : NEXT G
