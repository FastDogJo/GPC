10 REM 3D HAT (SOMBRERO) HIDDEN-LINE SURFACE - MODEL II BASICG 640X240
20 SCREEN 0 : CLS : LINE (0,0)-(639,239), 0, BF
30 DIM UH(300), LH(300)
40 FOR C = 0 TO 300 : UH(C) = 999 : LH(C) = -1 : NEXT C
50 REM SURFACE IS SYMMETRIC SO ONLY X = 0..10 (COLUMN C = X*30) IS COMPUTED AND MIRRORED ABOUT PIXEL 320
60 REM Z RUNS FRONT (0) TO BACK (20); UH/LH ARE THE UPPER/LOWER HORIZONS PER COLUMN
70 FOR Z = 0 TO 20 STEP .5
80 YB = (220 - (6.5 * Z)) : ZC = (Z - 10) : PV = 0
90 FOR C = 0 TO 300
100 X = (C / 30) : R = (1.2 * SQR((X * X) + (ZC * ZC)))
110 IF (R < .001) THEN F = 1 ELSE F = (SIN(R) / R)
120 Y = INT(YB - (60 * F)) : V = 0
130 IF (Y < UH(C)) THEN V = 1 : UH(C) = Y
140 IF (Y > LH(C)) THEN V = 1 : LH(C) = Y
150 IF (V = 0) THEN 200
160 IF (PV = 0) THEN 190
170 LINE ((319 + C),PY)-((320 + C),Y) : LINE ((321 - C),PY)-((320 - C),Y)
180 GOTO 200
190 PSET ((320 + C),Y) : PSET ((320 - C),Y)
200 PV = V : PY = Y
210 NEXT C
220 NEXT Z
230 GOTO 230
