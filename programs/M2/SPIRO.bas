10 REM SPIROGRAPH (HYPOTROCHOID) - MODEL II BASICG 640X240
20 SCREEN 0 : CLS
30 PI = 3.141593
40 DIM R(8), Q(8), E(8)
50 FOR I = 1 TO 8 : READ R(I), Q(I), E(I) : NEXT I
60 REM OUTER RADIUS, INNER RADIUS (COPRIME), PEN OFFSET
70 DATA 5,3,5, 8,3,5, 7,4,6, 11,4,7, 9,5,8, 13,5,6, 7,3,4, 12,5,9
80 FOR K = 1 TO 8
90 LINE (0,0)-(639,239), 0, BF
100 RB = (R(K) - Q(K)) : SC = (110 / (RB + E(K))) : N = (150 * Q(K))
110 FOR S = 0 TO N
120 T = ((((2 * PI) * Q(K)) * S) / N)
130 U = ((RB * T) / Q(K))
140 X = INT(320 + ((2 * SC) * ((RB * COS(T)) + (E(K) * COS(U)))))
150 Y = INT(120 + (SC * ((RB * SIN(T)) - (E(K) * SIN(U)))))
160 IF (S = 0) THEN PSET (X,Y) ELSE LINE (OX,OY)-(X,Y)
170 OX = X : OY = Y
180 NEXT S
190 FOR D = 1 TO 3000 : NEXT D
200 NEXT K
210 GOTO 80
