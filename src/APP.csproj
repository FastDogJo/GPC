<?xml version="1.0" encoding="utf-8"?>
<!-- CLAUDE : Based on SkeletonUI APP.csproj, trimmed to what GPC needs (NINI + WL + WebView2 settings window). No DX/MCP/Audio. -->
<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
  <AssemblyName>GPC</AssemblyName>
  <RootNamespace>FastDog</RootNamespace>
  <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
  <LangVersion>preview</LangVersion>
  <OutputType>WinExe</OutputType>
  <ApplicationIcon>../Assets/GPC.ico</ApplicationIcon>
  <UseWindowsForms>true</UseWindowsForms>
  <PlatformTarget>x64</PlatformTarget>
  <Prefer32Bit>false</Prefer32Bit>
  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  <Nullable>enable</Nullable>
  <ImplicitUsings>disable</ImplicitUsings>
  <WarningLevel>4</WarningLevel>
  <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  <NoWarn>$(NoWarn);CA1416;MSB3277</NoWarn>
  <ErrorReport>none</ErrorReport>
  <EnableTelemetry>false</EnableTelemetry>
  <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  <Deterministic>true</Deterministic>
  <DebugSymbols>false</DebugSymbols>
  <DebugType>none</DebugType>
  <Optimize>true</Optimize>
  <UseAppHost>true</UseAppHost>
  <EnableDefaultItems>true</EnableDefaultItems>
  <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  <SelfContained>false</SelfContained> <!-- CLAUDE : end user installs the .NET 10 Desktop Runtime -->
  <OutputPath>..\bin\</OutputPath>
  <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  <NuGetAudit>false</NuGetAudit>
  <!-- CLAUDE : single-file exe (use: dotnet publish -c Release, or ..\Package.ps1). Native WebView2Loader.dll is bundled and self-extracted. -->
  <PublishSingleFile>true</PublishSingleFile>
  <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
</PropertyGroup>

<ItemGroup>
<Compile Include="NINI.cs"><SubType>Code</SubType></Compile>
<Compile Include="WL.cs"><SubType>Code</SubType></Compile>
<Compile Include="Overlay_Main.cs"><SubType>Code</SubType></Compile>
<Compile Include="Overlay_Native.cs"><SubType>Code</SubType></Compile>
<Compile Include="Overlay_Settings.cs"><SubType>Code</SubType></Compile>
<Compile Include="Overlay_SettingsUI.cs"><SubType>Code</SubType></Compile>
<Compile Include="Overlay_Launch.cs"><SubType>Code</SubType></Compile>
<Compile Include="Overlay_Track.cs"><SubType>Code</SubType></Compile>
<Compile Include="Overlay_Frame.cs"><SubType>Code</SubType></Compile>
<Compile Include="Overlay_Window.cs"><SubType>Code</SubType></Compile>
<Compile Include="Overlay_Bezel.cs"><SubType>Code</SubType></Compile>
<Compile Include="Overlay_Render.cs"><SubType>Code</SubType></Compile>
<Compile Include="Overlay_Hotkeys.cs"><SubType>Code</SubType></Compile>
<Compile Include="Overlay_Power.cs"><SubType>Code</SubType></Compile>
<Compile Include="Overlay_PowerAnim.cs"><SubType>Code</SubType></Compile>
<Compile Include="Overlay_Mouse.cs"><SubType>Code</SubType></Compile>
<Compile Include="Overlay_Profile.cs"><SubType>Code</SubType></Compile>
<Compile Include="Overlay_P2.cs"><SubType>Code</SubType></Compile>
<Compile Include="Overlay_P2Capture.cs"><SubType>Code</SubType></Compile>
<Compile Include="Overlay_P2Shaders.cs"><SubType>Code</SubType></Compile>
<Compile Include="Overlay_P2Render.cs"><SubType>Code</SubType></Compile>
<Compile Include="Overlay_P2Glass.cs"><SubType>Code</SubType></Compile>
<Compile Include="Overlay_GlowParams.cs"><SubType>Code</SubType></Compile>

<!-- CLAUDE : UI files embedded (LogicalName = bare file name) so the exe is self-contained -->
<EmbeddedResource Include="OverlayControls.html" LogicalName="OverlayControls.html" />
<EmbeddedResource Include="OverlayControls.css" LogicalName="OverlayControls.css" />
<EmbeddedResource Include="OverlayControls.js" LogicalName="OverlayControls.js" />
<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3296.44" />
<PackageReference Include="Silk.NET.Direct3D11" Version="2.22.0" />
<PackageReference Include="Silk.NET.DXGI" Version="2.22.0" />
<PackageReference Include="Silk.NET.Direct3D.Compilers" Version="2.22.0" />
<Reference Include="../lib/nini-core.dll" Version="0.9.2.16"><Private>true</Private></Reference>
</ItemGroup>

</Project>
